{
    "name": "dsp-seed-finder",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "license": "Apache-2.0",
    "scripts": {
        "extract": "lingui extract --clean",
        "dev": "vite",
        "preview:web": "vite preview --port 5173",
        "preview:native": ".\\target\\release\\dsp_seed.exe",
        "build:web": "vite build",
        "build:browser:dev": "wasm-pack build --target web --dev",
        "build:browser": "wasm-pack build --target web",
        "build:native": "cargo build --release",
        "build": "npm run build:browser && npm run build:native && npm run build:web",
        "lint": "eslint .",
        "typecheck": "tsc -p configs/tsconfig.js.json --noEmit && tsc -p configs/tsconfig.worker.json --noEmit && tsc -p configs/tsconfig.node.json --noEmit",
        "test": "vitest run",
        "test:engine": "node scripts/verify-engine.mjs",
        "check": "npm run lint && npm run typecheck && npm test && npm run build:web"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.7.6",
        "@lingui/babel-plugin-lingui-macro": "6.0.1",
        "@lingui/core": "6.0.1",
        "@lingui/react": "6.0.1",
        "@lingui/vite-plugin": "6.0.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "exceljs": "^4.4.0",
        "jszip": "^3.10.1",
        "lucide-react": "^1.51.0",
        "nanoid": "^5.1.11",
        "radix-ui": "^1.6.7",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router-dom": "^7.13.1",
        "tailwind-merge": "^3.5.0",
        "three": "0.186.1",
        "tiny-emitter": "^2.1.0",
        "vite": "^6.4.2"
    },
    "devDependencies": {
        "@lingui/cli": "6.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/three": "0.186.0",
        "@vitejs/plugin-react": "^4.7.0",
        "binaryen": "132.0.0",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "^26.1.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.0",
        "vitest": "^3.2.4"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.60.2"
    }
}
